generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactLead {
  id        String   @id @default(uuid())
  name      String
  email     String
  service   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("superadmin")
  createdAt DateTime @default(now())
}

// Tabel untuk Data Client
model ClientData {
  id          String   @id @default(uuid())
  companyName String
  address     String
  order       String
  price       Float    // Menyimpan harga (angka)
  createdAt   DateTime @default(now())
}

// Tabel untuk Berita / CMS
model News {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  imageUrl  String?  // URL gambar (bisa kosong)
  createdAt DateTime @default(now())
}

// Tabel untuk CRM (Customer Relationship Management)
model CrmContact {
  id          String   @id @default(uuid())
  companyName String
  address     String
  email       String
  officePhone String
  createdAt   DateTime @default(now())
}


